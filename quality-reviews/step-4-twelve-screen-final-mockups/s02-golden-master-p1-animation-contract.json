{
  "schemaVersion": 2,
  "artifactId": "cats-tower-s02-golden-master-p1-animation-contract",
  "createdAt": "2026-09-01",
  "repository": "2hg7trp7rv-design/cats_tower",
  "branch": "kimi",
  "screen": "S02 normal battle",
  "status": "DESIGN_TIMING_CONTRACT_NOT_GAMEPLAY_IMPLEMENTATION",
  "purpose": "接敵、予備動作、攻撃、弾着、damage、hit reaction、defeat、rewardを一つの因果として読み、同一modelを壊さずP2/P3で再構築する。",
  "hardRules": [
    "tap/pointerで敵へ直接damageを与えない。",
    "AUTOをactive skill buttonにしない。",
    "damage numberはcombat event前に表示しない。",
    "rewardはreward/settlement event前に表示しない。",
    "projectileはreleaseでなくarrivalをimpactとする。",
    "hit reactionはimpact後、defeatはauthoritative event後。",
    "offline catch-upで架空の高速戦闘を再生しない。",
    "frameごとに体格、模様、装備、顔、anchorが変わるassetをreject。",
    "reduced motionでも因果をshape、label、barで残す。"
  ],
  "timebase": {
    "simulation": "canonical deterministic tick; renderから分離",
    "render": "requestAnimationFrameまたはengine loop、delta clamp 50ms",
    "timestamps": "simulation time、wall clock非依存",
    "targetFps": [60, 30],
    "timingToleranceMs": 34,
    "policy": "visual durationをcombat interval内で調整しても因果順とminimum recognitionを壊さない。"
  },
  "stateMachines": {
    "ally": {
      "states": ["idle", "walk", "anticipation", "attack", "recovery", "hit", "faint", "rewardReaction", "victory"],
      "transitions": ["idle<->walk", "idle|walk->anticipation->attack->recovery->idle|walk", "anticipation->idle|walk only on combat.attack_canceled", "any combat state->hit->idle|walk|faint", "idle|walk|recovery->rewardReaction->idle|walk|victory"],
      "interrupts": ["authoritative faint may interrupt", "anticipation cancel requires combat cancel", "released valid projectile may continue", "new threat may shorten rewardReaction"]
    },
    "enemy": {
      "states": ["idle", "move", "threat", "attack", "recovery", "hit", "low_hp", "defeat"],
      "transitions": ["idle<->move", "idle|move|low_hp->threat->attack->recovery", "threat->idle|move only on combat.telegraph_canceled", "combat states->hit", "hit|recovery->low_hp when authoritative HP band is LOW", "hit|recovery->idle|move when authoritative HP band is NORMAL", "low_hp->idle|move|threat when band clears to NORMAL", "any->defeat when authoritative"],
      "interrupts": ["defeat interrupts all", "canceled telegraph clears within100ms"]
    }
  },
  "clips": [
    {"id": "ally.idle", "durationMs": "1800-2800 loop", "read": "breathing、ear/tail micro motion、weapon weight", "rootMotion": false, "reducedMotion": "static pose plus blink no faster than5s"},
    {"id": "ally.walk", "durationMs": "700-900 cycle", "read": "foot contact、body weight、weapon lag", "rootMotion": "simulation position only", "markers": ["leftContact", "rightContact"]},
    {"id": "ally.recovery", "durationMs": "180-300", "read": "weapon settles、weight returns without a second strike", "markers": ["recoveryStart", "ready"]},
    {"id": "ally.hit", "durationMs": "160-240", "read": "impact-direction compression and readable recoil", "markers": ["hitStart", "recoilPeak", "recover"]},
    {"id": "ally.victory", "durationMs": "600-900 optional", "read": "short grounded acknowledgement without leaving battle formation", "markers": ["start", "peak", "ready"], "rule": "combat.victory_state_changed event and eligibleEntityId required"},
    {"id": "ally.anticipation.melee", "durationMs": "180-260", "minimumRecognitionMs": 160, "read": "weight back、clear weapon path、target lock", "markers": ["start", "aimLocked"]},
    {"id": "ally.anticipation.ranged", "durationMs": "220-340", "minimumRecognitionMs": 180, "read": "bow drawまたはsupport bell、path preview without damage", "markers": ["start", "aimLocked", "chargeReady"]},
    {"id": "ally.attack.melee", "durationMs": "120-180", "read": "single arc to contact", "markers": ["release", "contactCandidate"], "eventRule": "combat event confirms impact"},
    {"id": "ally.attack.ranged", "durationMs": "120-180", "read": "release recoil、projectile separation", "markers": ["release", "projectileSpawn"], "eventRule": "spawn is not damage"},
    {"id": "projectile.travel", "durationMs": "160-420 distance-bound", "read": "origin-to-target path", "markers": ["spawn", "arrival"], "arrivalToleranceMs": 17},
    {"id": "impact.normal", "durationMs": "90-150", "read": "contact flash、direction lines、dust", "markers": ["impactStart", "damageStart", "impactEnd"], "hitStopMs": "45-65 visual-only"},
    {"id": "impact.critical", "durationMs": "130-210", "read": "larger double shape、critical label、single flash", "markers": ["impactStart", "criticalStart", "damageStart", "impactEnd"], "hitStopMs": "65-85 visual-only"},
    {"id": "impact.heal", "durationMs": "200-360", "read": "upward leaf-light shape and exact positive amount, spatially distinct from coin reward", "markers": ["healStart", "hpIncreaseVisible", "healEnd"], "rule": "combat.heal_applied event required; role or green color alone never triggers it"},
    {"id": "impact.residue", "durationMs": "240-360 after impact", "read": "low-contrast directional dust/outline that preserves the hit origin without looking like a second hit", "markers": ["residueStart", "residueEnd"], "rule": "no damage、no HP mutation、no flash; GM06 capture at700ms may retain this residue"},
    {"id": "target.hit", "durationMs": "160-240", "read": "compress toward impact then recoil", "markers": ["recoilPeak", "recover"]},
    {"id": "enemy.idle", "durationMs": "1600-2400 loop", "read": "breath、weight、threat silhouette remains identifiable", "rootMotion": false},
    {"id": "enemy.move", "durationMs": "700-900 cycle", "read": "foot contact and forward intent", "rootMotion": "simulation position only", "markers": ["leftContact", "rightContact"]},
    {"id": "enemy.attack", "durationMs": "160-240", "read": "commit follows enemy.threat and reaches bound attackOrigin", "markers": ["release", "contactCandidate"], "eventRule": "combat event confirms impact"},
    {"id": "enemy.recovery", "durationMs": "180-300", "read": "attack extremity returns to readable stance", "markers": ["recoveryStart", "ready"]},
    {"id": "enemy.hit", "durationMs": "160-240", "read": "impact-direction compression and recoil", "markers": ["hitStart", "recoilPeak", "recover"]},
    {"id": "enemy.low_hp", "durationMs": "1200-1800 loop", "read": "authoritative low-HP posture plus non-color outline notch", "markers": ["loopStart", "loopEnd"], "rule": "enemy.hpBand LOW event/state required; UI never derives the threshold"},
    {"id": "enemy.defeat", "durationMs": "420-620", "read": "stance loss、ground contact、silhouette dissolve", "markers": ["start", "grounded", "rewardSourceAvailable", "remove"], "rule": "reward source取得前にdestroyしない"},
    {"id": "ally.faint", "durationMs": "360-520", "read": "weapon lower、kneel/curl", "markers": ["start", "grounded"], "rule": "enemy defeatのように消さない"},
    {"id": "ally.rewardReaction", "durationMs": "360-560", "read": "short glance/uplift while combat-ready", "markers": ["start", "peak", "end"], "rule": "reward event時だけ"},
    {"id": "enemy.threat", "durationMs": "420-900 event-bound", "minimumRecognitionMs": 300, "read": "body anticipation、ground shape、direction", "markers": ["start", "commit"], "rule": "countdownは実timing時だけ"},
    {"id": "floor.transition", "durationMs": "600-900", "read": "upward light、exact floor crossfade、battlefield advance", "markers": ["start", "floorSwap", "nextReveal", "end"], "rule": "settlement許可前にnext floorを確定しない"},
    {"id": "support.arrival", "durationMs": "500-800", "read": "battle外縁から到着し対象へeffect transfer", "markers": ["visible", "transfer", "applied", "exit"], "rule": "temporarySupport event時だけ、party4に混ぜない"}
  ],
  "stateToClip": {
    "ally": {"idle": ["ally.idle"], "walk": ["ally.walk"], "anticipation": ["ally.anticipation.melee", "ally.anticipation.ranged"], "attack": ["ally.attack.melee", "ally.attack.ranged"], "recovery": ["ally.recovery"], "hit": ["ally.hit"], "faint": ["ally.faint"], "rewardReaction": ["ally.rewardReaction"], "victory": ["ally.victory"]},
    "enemy": {"idle": ["enemy.idle"], "move": ["enemy.move"], "threat": ["enemy.threat"], "attack": ["enemy.attack"], "recovery": ["enemy.recovery"], "hit": ["enemy.hit"], "low_hp": ["enemy.low_hp"], "defeat": ["enemy.defeat"]},
    "selectionRule": "role/equipment and authoritative combat action choose a listed variant; renderer never invents a missing clip"
  },
  "effectToClip": {"combat.heal_applied": "impact.heal", "selectionRule": "event-bound only; source and target anchors required"},
  "combatCausality": {
    "requiredOrder": ["contact/range", "anticipation", "release", "travel/contact", "impact", "damage+HP", "hit reaction", "defeat", "reward", "floor transition"],
    "minimumWindowsMs": {"anticipation": 160, "impact": 90, "damageNumber": 450, "defeatSilhouette": 280, "rewardFeedback": 900},
    "damageNumber": {"start": "impact frame or immediately after", "durationMs": "650-900", "movementCssPx": "8-20 upward", "maximumConcurrent": 4, "source": "exact event amount"},
    "hpBar": {"authoritativeUpdate": "damage event", "lagMs": "180-260", "zeroRule": "HP visual alone does not mint defeat", "unknownRule": "unknown is not100%"},
    "hitStop": {"scope": "attacker、target、contact FX only", "simulationPaused": false, "uiPaused": false}
  },
  "gm06Storyboard": {
    "timeMapping": "review fixture only: simulationTick is a decimal millisecond offset from GM06 sequence start, so tickDurationMs=1. Production simulation tick duration remains canonical-engine-owned and is never inferred from this fixture.",
    "timelineMs": [
      {"t": 0, "event": "ルナ(character.launch.002) ranged anticipation toward enemy.normal.002"},
      {"t": 220, "event": "ルナ arrow release and projectile spawn from projectileOrigin"},
      {"t": 390, "event": "same projectile arrives at enemy.normal.002 hitTarget; critical=false selects impact.normal、HP、damage text"},
      {"t": 440, "event": "readable hit recoil"},
      {"t": 520, "event": "authoritative defeat begins"},
      {"t": 680, "event": "labeled reward event"},
      {"t": 980, "event": "reward destination、next-floor eligible"}
    ],
    "captureMomentMs": 700,
    "captureRequirements": ["attacker follow-through", "impact residue+damage at hitTarget", "enemy defeat start", "reward linked to defeat source", "sequence markers do not imply simultaneity"]
  },
  "layering": {
    "formationHints": {"front": ["character.launch.001", "contextual character.launch.004"], "back": ["character.launch.002", "character.launch.003"]},
    "entityGroup": "all cats, enemies and temporary support entities share combatEntities.depthSorted",
    "depthSort": "footAnchor worldY then stable entityId; role/slot is never a z-order override",
    "minimumSeparationCssPx": 8,
    "visibleRequirement": "each cat face+main equipment >=65%",
    "phaseOffsetMs": "150-420",
    "rule": "4体を同frame・同歩調・同一lineにしない。"
  },
  "camera": {
    "follow": "party centroid low-frequency、amplitude <= viewport width3%",
    "shake": {"normalCssPx": "0-2", "criticalCssPx": "2-4", "durationMs": "70-120", "fullUi": false, "reducedMotion": 0},
    "parallax": "asset contract係数以内",
    "short": "footAnchor、enemy HP、attack pathをcropしない",
    "tall": "視野と奥行きを増やし、cat/UIを比例拡大しない"
  },
  "offlineReconciliation": {
    "viewStates": ["NO_PROGRESS", "ELAPSED_UNKNOWN", "RECONCILING_INDETERMINATE", "RECONCILING_DETERMINATE", "PROVISIONAL", "CONFIRMING", "CONFIRMED", "REJECTED", "RETRYABLE_ERROR", "UNKNOWN"],
    "orchestratorEntryStates": ["BACKGROUND_RECONCILE", "OFFLINE", "RETRYABLE_ERROR"],
    "motion": ["sheet 180-240ms", "determinate progress only if real", "provisional has no celebration", "confirmed may play one cue"],
    "forbidden": ["架空高速戦闘", "未確定coin burst", "偽sync complete", "確定前wallet update"]
  },
  "rewardIntegrity": {
    "dedupeKey": "rewardEventId + settlementId + statusVersion",
    "states": ["none", "provisional", "confirming", "confirmed", "rejected", "retryable_error"],
    "rules": {"provisional": "見込みlabel、no destination", "confirming": "照合中、stable amount", "confirmed": "確定label、one trail", "rejected": "付与なし、wallet retained", "retryable_error": "再確認が必要、no duplicate"}
  },
  "reducedMotion": {
    "disabled": ["parallax", "screen shake", "loop pulse", "coin arc", "rapid particles", "full sweep"],
    "replacements": {"anticipation": "two poses+shape retained for at least160ms total evidence window", "impact": "static mark160ms", "damage": "static text700ms", "defeat": "120ms crossfade followed by static defeat pose+label retained so total evidence window is at least280ms", "reward": "state panel retained for at least900ms total evidence window", "floor": "120ms label crossfade+cut"},
    "causalityPreserved": true
  },
  "performance": {
    "pooled": ["projectiles", "impact sprites", "damage text", "particles", "reward trails"],
    "maximumConcurrent": {"projectiles": 8, "impactEffects": 4, "damageNumbers": 4, "minorParticles": 24, "rewardTrails": 1},
    "degradationOrder": ["dust", "background particles", "secondary trails", "duplicate minor damage"],
    "neverDegrade": ["anticipation", "impact mark", "HP", "defeat", "reward state label"]
  },
  "eventInterface": {
    "inputs": ["combat.contact_entered", "combat.attack_started", "combat.attack_canceled", "combat.attack_released", "combat.telegraph_canceled", "combat.projectile_spawned", "combat.projectile_arrived", "combat.damage_applied", "combat.heal_applied", "combat.entity_hit", "combat.entity_fainted", "combat.entity_defeated", "combat.victory_state_changed", "reward.provisional", "reward.confirmed", "reward.rejected", "tower.floor_transition_allowed", "support.arrival_started", "support.effect_applied", "offline.reconciliation_changed"],
    "requiredEnvelopeFields": ["eventId", "simulationTick", "stateVersion"],
    "identityRule": "Entity-scoped terminal/hit events use entityId. Directed combat/effect events use sourceEntityId and targetEntityId. Global floor/offline events use their event-specific IDs and do not fabricate entityId.",
    "projectileFields": ["projectileEntityId", "sourceEntityId", "targetEntityId", "attackEventId"],
    "damageFields": ["sourceEntityId", "targetEntityId", "amountDecimal", "critical"],
    "healFields": ["sourceEntityId", "targetEntityId", "amountDecimal"],
    "cancelFields": ["sourceEntityId", "targetEntityId optional", "reasonCode", "canceledAttackEventId or telegraphEventId"],
    "entityTerminalFields": ["entityId", "causeEventId"],
    "victoryFields": ["state", "eligibleEntityIds", "causeEventId"],
    "rewardFields": ["rewardEventId", "settlementId", "status", "statusVersion", "currencyCanonicalId", "amountDecimal", "sourceEntityId", "defeatEventId"],
    "uiWriteBack": "visual animationからはnone"
  },
  "qa": ["melee order", "ranged arrival order", "projectile after attacker hit", "canceled ally anticipation exits without impact", "canceled telegraph exits to normal state within100ms", "normal-HP enemy recovery/hit returns to idle or move", "heal requires event and authoritative HP increase", "HP zero without defeat", "provisional reward", "dedupe after reconnect", "4 cats at320x568", "30fps order", "reduced motion causality", "resume reconciliation", "temporary support separate"],
  "verdictBoundary": {"gameplayValuesChanged": false, "runtimeImplemented": false, "step4Pass": false, "physicalIPhoneVerified": false}
}
