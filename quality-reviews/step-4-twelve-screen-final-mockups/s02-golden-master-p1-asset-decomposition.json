  "principles": [
    "Golden Master全画面画像は比較基準でありruntimeへ貼らない。",
    "背景、猫、敵、effect、UI、text、numberを独立layerへ分ける。",
    "生成画像内に日本語、HP、floor、currency、button、reward amountを含めない。",
    "同一entityは全animationで体格、模様、顔、装備、palette、anchorを固定する。",
    "背景hidden extentとanimation extremityの透明余白を確保する。",
    "UI frameは9-sliceまたはvectorで伸縮する。"
  ],
  "coordinateSystem": {
    "referenceArtboardCssPx": "390x844",
    "assetNormalizedOrigin": "transparent source左上(0,0)、右下(1,1)",
    "worldOrigin": "battlefield左下",
    "worldAxes": {"x": "0 ally entrance, 1 enemy entrance", "y": "0 ground, 1 battlefield top"},
    "zOrder": ["bg.sky", "bg.far", "bg.mid", "bg.ground", "combatEntities.depthSorted", "effects.contact", "bg.foreground", "bg.light", "bg.fog", "bg.particles", "battleText/UI"],
    "compositingRule": "background layer order matches art-direction order 0..7. Every cat, enemy and temporary support entity participates in one combatEntities.depthSorted group ordered by footAnchor worldY, then stable entityId; role or slot never forces an entity above another. bg.light/bg.fog are masked away from face, HP, labels and UI; contact effects remain locally above their bound source/target even though ambient overlays follow the background ordering.",
    "anchorRule": "position、shadow、collision、depth sortはfootAnchor基準。trimmed image bounds基準にしない。"
  },
  "background": {
    "common": {
      "textFree": true,
      "characterFree": true,
      "uiFree": true,
      "aspectRatioPreserved": true,
      "hiddenHorizontalExtent": "reference cropの左右各12%以上",
      "hiddenVerticalExtent": "reference cropの上下各10%以上",
      "reducedMotionParallax": 0
    },
    "layers": [
      {"id": "bg.sky", "content": "夜空、月光、低密度雲", "alpha": false, "sourceMinimumPx": "960x1280", "formats": ["AVIF", "WebP"], "budgetKiB": 180, "parallaxMaximum": 0.02},
      {"id": "bg.far", "content": "無制限塔、遠い梁、窓灯り", "alpha": true, "sourceMinimumPx": "1152x1536", "formats": ["WebP alpha"], "budgetKiB": 260, "parallaxMaximum": 0.10},
      {"id": "bg.mid", "content": "石回廊、木梁、真鍮設備、doorway", "alpha": true, "sourceMinimumPx": "1152x1536", "formats": ["WebP alpha"], "budgetKiB": 360, "parallaxMaximum": 0.28},
      {"id": "bg.ground", "content": "石床、contact shadow受け面、移動余白", "alpha": true, "sourceMinimumPx": "1536x512", "formats": ["WebP alpha"], "budgetKiB": 260, "groundLineNormalizedY": 0.82},
      {"id": "bg.foreground", "content": "端の梁、chain、rail", "alpha": true, "sourceMinimumPx": "1152x1536", "formats": ["WebP alpha"], "budgetKiB": 220, "occlusionLimit": "左右各8%、下端12%"},
      {"id": "bg.light", "content": "ally amber、enemy violet、neutral contact light", "alpha": true, "sourceMinimumPx": "960x1280", "formats": ["WebP alpha", "procedural"], "budgetKiB": 120},
      {"id": "bg.fog", "content": "floor fogとdepth fog", "alpha": true, "sourceMinimumPx": "1024x384", "formats": ["WebP alpha", "sprite strip"], "budgetKiB": 100},
      {"id": "bg.particles", "content": "dust、ember、magic mote", "alpha": true, "formats": ["sprite atlas", "procedural"], "budgetKiB": 64, "maximumVisible": 24}
    ]
  },
