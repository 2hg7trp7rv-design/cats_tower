    {"viewState": "ELAPSED_UNKNOWN", "exactLabel": "経過時間確認中", "amountVisibility": "hidden", "progress": "indeterminate", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}},
    {"viewState": "RECONCILING_INDETERMINATE", "exactLabel": "照合中", "amountVisibility": "hidden", "progress": "indeterminate", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}},
    {"viewState": "RECONCILING_DETERMINATE", "exactLabel": "照合中", "amountVisibility": "hidden", "progress": "trusted determinate only", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}},
    {"viewState": "PROVISIONAL", "exactLabel": "見込み", "amountVisibility": "visible with 見込み on every row", "progress": "none", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}},
    {"viewState": "CONFIRMING", "exactLabel": "照合中", "amountVisibility": "visible with 見込み on every row", "progress": "indeterminate unless trusted ratio exists", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}},
    {"viewState": "CONFIRMED", "exactLabel": "確定", "amountVisibility": "visible with 確定 on every row", "progress": "none", "walletMayReflectAuthoritativeSettlement": "only matching settlementId+statusVersion may already be reflected by wallet authority", "uiMutationAlwaysForbidden": true, "celebration": "one deduped cue", "actions": {"close": true, "retry": false, "continue": true}},
