    {"viewState": "UNKNOWN", "exactLabel": "状態確認中", "amountVisibility": "hidden", "progress": "indeterminate", "walletMayReflectAuthoritativeSettlement": false, "uiMutationAlwaysForbidden": true, "celebration": false, "actions": {"close": true, "retry": false, "continue": false}}
