{
  "schemaVersion": 2,
  "artifactId": "cats-tower-s02-golden-master-p1-data-binding-matrix",
  "createdAt": "2026-09-01",
  "repository": "2hg7trp7rv-design/cats_tower",
  "branch": "kimi",
  "screen": "S02 normal battle",
  "status": "FUTURE_BINDING_CONTRACT_NOT_SCHEMA_CHANGE",
  "canonicalAuthority": ["canonical/SCREEN_STATE_REGISTRY.json", "canonical/STABLE_ID_REGISTRY.json", "canonical/STATE_TRANSITION_CONTRACT.json", "canonical/STEP2_DEPENDENCY_CLOSURE.json"],
  "adapter": {
    "name": "S02BattleViewModel",
    "role": "canonical stateを表示専用に正規化するread-only adapter。P1ではinterfaceだけを定義。",
    "versionFields": ["schemaVersion", "stateVersion", "simulationTick", "settlementVersion when present"],
    "mustNot": ["canonicalへUI convenience fieldを書戻す", "unbounded decimalをNumberへ丸める", "animationからdamage/reward/ownershipを生成", "missing値をsampleで補う", "paid/free rubyを曖昧合算", "temporary supportをparty4へ混入"],
    "unknownPolicy": "criticalは状態確認中、noncriticalは非表示。last confirmedを使う場合は更新待ちlabel。"
  },
  "fixturePolicy": {
    "namespace": "s02.p1.fixture.<GM-ID>",
    "meaning": "layout/visual review専用のsynthetic schema-valid event/state。実player、live server、real payout、wallet mutationを表さない。GM06/GM07は因果と状態意味を例示するが、三つのwatermarkなしに表示しない。",
    "requiredWatermark": ["DESIGN REVIEW", "S02 GOLDEN MASTER", "NOT RUNTIME"],
    "runtimeImportForbidden": true
  },
  "formatters": {
    "floor": "positive normalized decimal stringをlocale grouping+階。上限語なし。",
    "amount": "canonical decimal string。policyがなければ独自K/M/Bなし。",
    "hp": "current/maxをclampしたratio+exact text。max unknownならindeterminate。",
    "duration": "trusted elapsed secondsから日/時/分。client wall clockだけで確定しない。",
    "state": "closed enum辞書。unknownを推測しない。"
  },
  "bindings": [
    {"id": "review.watermark", "priority": "P0_REVIEW_ONLY", "source": "review route metadata", "authority": "P1 artifact", "display": "three required labels", "fallback": "missing is review failure", "antiFake": "runtimeでは非表示"},
    {"id": "screen.uiState", "priority": "P0", "source": "S02.uiState", "authority": "state orchestrator", "display": "READY/LOADING/OFFLINE/RECONCILE/ERROR等に対応するsurface", "fallback": "UNKNOWN/状態確認中; actions disabled; retry is absent unless capability is supplied"},
    {"id": "tower.floor", "priority": "P0_ALWAYS", "source": "S02BattleViewModel.floor.displayDecimal", "rawAuthority": "S02.floorId joined to canonical progression authority", "authority": "deterministic run cache; progression is server-verifiable", "type": "positive normalized decimal string", "display": "floor formatter", "fallback": "階数確認中", "antiFake": "opaque floorIdをnumberとしてformatせず、0/1を補わない"},
    {"id": "encounter.identity", "priority": "P0_ALWAYS", "source": "S02.enemyWave.currentEncounterId + enemyId", "authority": "deterministic encounter", "display": "approved localized name/class", "fallback": "敵情報確認中", "antiFake": "別enemyを代入しない"},
    {"id": "encounter.objective", "priority": "P0_ALWAYS", "source": "objectiveKind/currentDecimal/requiredDecimal", "authority": "deterministic encounter", "display": "canonical objective一つ", "fallback": "目標確認中; ratio hidden", "antiFake": "visual enemy countから推測しない"},
    {"id": "enemy.hp", "priority": "P0_ALWAYS", "source": "S02BattleViewModel.encounter.enemyHp.currentDecimal/maxDecimal/status", "rawAuthority": "active enemy combat snapshot", "authority": "combat simulation", "display": "bar+exact text at every required viewport; reflow rather than omission", "fallback": "HP確認中; indeterminate", "antiFake": "unknownをfull表示しない"},
    {"id": "enemy.hpBand", "priority": "P2_REAL_STATE", "source": "S02BattleViewModel.encounter.enemyHp.band", "rawAuthority": "combat simulation authoritative HP-band state", "closedValues": ["NORMAL", "LOW", "UNKNOWN"], "authority": "combat simulation", "display": "LOWだけlow_hp pose/outline; numeric threshold is not calculated by UI", "fallback": "UNKNOWN; no low_hp treatment", "antiFake": "UI ratioから独自thresholdを作らない"},
    {"id": "enemy.threat", "priority": "P0_WHEN_REAL", "source": "telegraph event enemyId/actionKind/target/commitTick/cancel", "authority": "combat simulation", "display": "pose+shape+label; countdown only if real", "fallback": "no countdown; clear on cancel"},
    {"id": "battle.autoState", "priority": "P0_ALWAYS", "source": "S02BattleViewModel.auto.status closed enum", "rawAuthority": "S02.autoState", "authority": "run control", "display": "AUTO+state label", "fallback": "状態確認中", "antiFake": "not active skill or damage command"},
    {"id": "party.slotIdentity", "priority": "P1_ALWAYS", "source": "S02.party4[0..3].characterId/slotIndex", "authority": "ownership/formation+run state", "display": "portrait、name、slot、state", "fallback": "skeleton+読込中", "antiFake": "unowned portraitをfieldにしない"},
    {"id": "party.slotState", "priority": "P1_ALWAYS", "source": "ownership、eligibility、slot、activeFieldEntity linkage", "authority": "server ownership/formation+run cache", "display": "label+shape+edge/icon", "fallback": "状態確認中; disabled", "antiFake": "available is neither owned nor field"},
    {"id": "party.allyHp", "priority": "P1_WHEN_FIELD", "source": "S02BattleViewModel.party4[field].hp.currentDecimal/maxDecimal/status", "rawAuthority": "active field entity combat snapshot", "authority": "combat simulation", "display": "field member compact HP bar and state", "fallback": "field member is HP確認中 with indeterminate track; non-field card does not fabricate combat HP"},
    {"id": "party.fieldEntity", "priority": "P0_VISUAL", "source": "position/facing/animation/targetEntityId", "authority": "combat simulation", "display": "approved asset by characterId", "fallback": "loading composition", "antiFake": "active field entityだけ戦闘表示"},
    {"id": "combat.attack", "priority": "P2_REAL_EVENT", "source": "attack_started/released/projectile events", "authority": "combat simulation", "display": "animation contract", "fallback": "idle/walk; no attack", "antiFake": "CSS timer aloneは禁止"},
    {"id": "combat.damage", "priority": "P2_REAL_EVENT", "source": "damage_applied eventId/source/target/amountDecimal/critical/tick", "authority": "combat simulation", "display": "exact number+authoritative HP update; hit reaction is controlled only by combat.hit", "fallback": "no number/effect", "antiFake": "visual layer calculates nothing and does not synthesize entity_hit"},
    {"id": "combat.hit", "priority": "P2_REAL_EVENT", "source": "entity_hit eventId/entityId/causeEventId/simulationTick", "authority": "combat simulation", "display": "bound target hit reaction after matching cause event", "fallback": "no hit reaction", "antiFake": "damage event、CSS timerまたはHP変化だけからentity_hitを生成しない"},
    {"id": "combat.heal", "priority": "P2_REAL_EVENT", "source": "heal_applied eventId/sourceEntityId/targetEntityId/amountDecimal/simulationTick", "authority": "combat simulation", "display": "exact heal number+authoritative ally HP increase+bound heal effect", "fallback": "no heal number/effect", "antiFake": "role、green color、idle timerまたはvisual layerからhealを生成しない"},
    {"id": "combat.defeat", "priority": "P2_REAL_EVENT", "source": "entity_defeated eventId/entityId", "authority": "combat simulation", "display": "defeat clip+progress", "fallback": "last non-defeat state", "antiFake": "HP bar aloneで生成しない"},
    {"id": "tower.floorTransition", "priority": "P2_REAL_EVENT", "source": "tower.floor_transition_allowed eventId/fromFloorDisplayDecimal/toFloorDisplayDecimal/settlementId/settlementStatusVersion/simulationTick", "authority": "canonical progression orchestrator joined to matching confirmed settlement", "display": "floor transition clip and exact from/to floor update", "fallback": "no transition; retain last confirmed floor", "antiFake": "defeat、objective full、reward FXまたはlocal timerだけでnext floorを確定しない"},
    {"id": "party.faintState", "priority": "P2_REAL_EVENT", "source": "combat.entity_fainted eventId/entityId", "authority": "combat simulation", "display": "ally faint clip and non-disappearing down state", "fallback": "last non-faint authoritative state", "antiFake": "ally HP zeroだけでfaintを生成しない"},
    {"id": "battle.victoryState", "priority": "P2_REAL_EVENT", "source": "combat.victory_state_changed eventId/state/eligibleEntityIds", "authority": "combat/run orchestrator", "display": "optional ally victory clip only for eligible field entities", "fallback": "no victory treatment", "antiFake": "enemy defeat、rewardまたはfloor transitionだけでvictoryを推測しない"},
    {"id": "reward.feedback", "priority": "P2_REAL_EVENT", "source": "reward event: rewardEventId/settlementId/status/statusVersion/currencyCanonicalId/amountDecimal/sourceEntityId/defeatEventId", "authority": "server-verifiable settlement or explicit provisional run result", "display": "source+amount+見込み/照合中/確定/付与なし", "fallback": "hidden or 再確認が必要", "antiFake": "matching sourceEntityId/defeatEventIdなしにdefeat sourceへ結ばない。random amount、animation wallet update、premature confirmed禁止"},
    {"id": "wallet.runCoin", "priority": "P1_ALWAYS", "source": "S02BattleViewModel.resources.runCoin.amountDecimal/status/stateVersion", "rawAuthority": "wallet.coin.run", "authority": "versioned wallet", "display": "exact amount; pending separate", "fallback": "残高確認中 with indeterminate state; never zero", "antiFake": "reward FXはwalletを直接mutateしない"},
    {"id": "wallet.ruby", "priority": "P3", "source": "provenance-specific ledgers", "authority": "server wallet", "display": "S02 P1では非表示", "fallback": "none", "antiFake": "provenance-safe policyなしのaggregate禁止"},
    {"id": "profile.rank", "priority": "P3", "source": "future canonical profile/rank authority only if defined", "authority": "server profile", "display": "S02 P1では非表示", "fallback": "none", "antiFake": "固定RANK 18等のreview fixtureをplayer stateとして表示しない"},
    {"id": "support.temporary", "priority": "P2_WHEN_REAL", "source": "S02.temporarySupport supportId/state/arrival/effect/remaining", "authority": "run cache+eligibility", "display": "name+state+real effect", "fallback": "hidden", "antiFake": "party4 slotに入れない"},
    {"id": "support.shopDelivery", "priority": "P1_ALWAYS_SUMMARY", "source": "S02BattleViewModel.support.summaryState/effectSummary/arrivalStatus/applicationScope/targetEncounterId/status", "rawAuthority": "S05 projectedCombatSupport/delivery snapshot", "authority": "profile config+forecast", "display": "ACTIVEは現在支援、SCHEDULEDはexact prefix 次戦支援 and current battleへ非適用、NONEは支援なし、UNKNOWNは支援状態確認中; details to S05", "fallback": "支援状態確認中; no effect claim", "antiFake": "SCHEDULEDはauthoritative next scope/targetなしに生成せず、current buffとして描画しない。price/fake timer/unconfigured buff禁止"},
    {"id": "offline.elapsed", "priority": "P0_GM07", "source": "offlineCatchup.eligibleElapsedSeconds/cap", "authority": "reconciliation input", "display": "duration+cap", "fallback": "経過時間確認中", "antiFake": "local timestampだけで確定しない"},
    {"id": "offline.progress", "priority": "P0_GM07", "source": "S02BattleViewModel.offline.viewState/progressRatio", "rawAuthority": "offlineCatchup+settlementStatus", "authority": "reconciliation orchestrator", "closedViewStates": ["NO_PROGRESS", "ELAPSED_UNKNOWN", "RECONCILING_INDETERMINATE", "RECONCILING_DETERMINATE", "PROVISIONAL", "CONFIRMING", "CONFIRMED", "REJECTED", "RETRYABLE_ERROR", "UNKNOWN"], "display": "放置収益なし/経過時間確認中/照合中/見込み/確定/付与なし/再確認が必要/状態確認中", "fallback": "UNKNOWN with labeled indeterminate state and no retry", "antiFake": "fake percentまたはretry capabilityの捏造禁止"},
    {"id": "offline.outcome", "priority": "P0_GM07", "source": "offline outcome rows+settlement", "authority": "provisional calculation or server settlement", "display": "each row carries state", "fallback": "amount hidden; state retained", "antiFake": "confirmed/wallet deltaを先出ししない"},
    {"id": "settlement.status", "priority": "P0_WHEN_PENDING_ERROR", "source": "S02.settlementStatus/id/statusVersion", "authority": "settlement orchestrator", "display": "pending/confirmed/rejected/retry/error+action", "fallback": "状態確認中; no advance"},
    {"id": "navigation.primary", "priority": "P0_ALWAYS", "source": "S02BattleViewModel.navigation.primary routeId/status/labelKey", "rawAuthority": "canonical route availability+uiState", "authority": "router", "display": "exact label 編成を整える; expected canonical S06 destination", "fallback": "disabled with 読込中; geometry retained", "antiFake": "S06 route bindingまたはapproved labelKeyなしにenableせず、skill/damage/未実装route禁止"},
    {"id": "navigation.bottom", "priority": "P1_ALWAYS", "source": "S02BattleViewModel.navigation.destinations[5] joined to canonical route registry", "authority": "router", "display": "review fixture uses exact labels; runtime enables only bound routes and marks S02 selected", "fallback": "unbound destination disabled with 利用不可; no click side effect", "antiFake": "review label alone does not create a route; real eventなしのbadge禁止"},
    {"id": "navigation.partyCard", "priority": "P1_ACTION", "source": "S02BattleViewModel.party4[].detailRouteId/routeStatus joined to route registry", "authority": "router; expected responsibility S06 character", "display": "selected character detail/party destination", "fallback": "disabled with 利用不可", "antiFake": "characterIdまたはbound routeなしに遷移しない"},
    {"id": "navigation.supportSummary", "priority": "P1_ACTION", "source": "S02BattleViewModel.support.detailRouteId/routeStatus joined to route registry", "authority": "router; expected responsibility S05 shop-delivery", "display": "支援を確認", "fallback": "disabled with 利用不可; summary remains readable", "antiFake": "S05 bindingなしのtransparent link禁止"},
    {"id": "tutorial.cue", "priority": "P2_REAL_STATE", "source": "S02BattleViewModel.tutorial.stepId/status/targetId", "rawAuthority": "canonical tutorial orchestrator", "authority": "tutorial state", "display": "one approved instruction anchored to one real target", "fallback": "hidden", "antiFake": "unknown/complete stepには表示しない"},
    {"id": "feedback.toast", "priority": "P2_REAL_EVENT", "source": "S02BattleViewModel.feedback.latest eventId/kind/messageKey/retryCapability", "rawAuthority": "navigation/read/reconciliation response event", "authority": "response orchestrator", "display": "localized messageKey once", "fallback": "hidden", "antiFake": "free-form success/server claimを生成しない"},
    {"id": "notification.badge", "priority": "P2_REAL_STATE", "source": "S02BattleViewModel.navigation.destinations[].unreadState/count", "rawAuthority": "destination-owned unread authority", "authority": "route registry projection", "display": "real count or dot with accessible label", "fallback": "no badge", "antiFake": "unknownをred dotにしない"},
    {"id": "help.tooltip", "priority": "P2_LOCAL_REQUEST", "source": "approved HelpContentRegistry contentId/version plus focus/longPress/help-request", "authority": "versioned static help registry and local UI request", "display": "approved short content near target", "fallback": "hidden", "antiFake": "dynamic gameplay/reward claimをhelp文から生成しない"},
    {"id": "state.cooldown", "priority": "P2_REAL_STATE", "source": "S02BattleViewModel.supportOrAutoAction.cooldown.status/endsAtSimulationTick", "rawAuthority": "combat/support simulation", "authority": "deterministic state", "display": "mask+remaining metadata+automatic state label", "fallback": "no cooldown treatment", "antiFake": "押せるactive skillとして表示しない"},
    {"id": "ui.interaction", "priority": "LOCAL_TRANSIENT", "source": "native pointer/keyboard/focus/selection state tied to a real control", "authority": "browser/engine interaction state", "display": "pressed/focus/selected visual", "fallback": "normal", "antiFake": "disabled/locked/loading/errorをlocal hoverから生成しない"},
    {"id": "error.recovery", "priority": "P0_ERROR", "source": "error domain/code/retryCapability/lastConfirmedVersion", "authority": "orchestrator", "display": "plain status+retained data; retry only when retryCapability=true", "fallback": "状態確認中; no retry and no destructive action", "antiFake": "HTTP successだけでserver healthyまたはretryableとしない"}
  ],
  "partyStateDecisionTable": [
    {"precedence": 1, "match": "owned===true && slotAssigned===true && activeFieldEntity===true", "eligible": "any", "result": "field", "label": "戦場参加中"},
    {"precedence": 2, "match": "owned===true && activeFieldEntity===false", "slotAssigned": "any", "eligible": "any", "result": "owned", "label": "所有済み"},
    {"precedence": 3, "match": "owned===false && slotAssigned===false && activeFieldEntity===false && eligible===true", "result": "available", "label": "加入可能"},
    {"precedence": 4, "match": "owned===false && slotAssigned===false && activeFieldEntity===false && eligible===false", "result": "locked", "label": "未解放"},
    {"precedence": 5, "match": "all other, missing, unknown, or contradictory combinations", "result": "unknown", "label": "状態確認中", "severity": "P0_CONFLICT", "examples": ["activeFieldEntity without owned", "activeFieldEntity without slot", "unowned slot assignment", "unknown eligibility for unowned"]}
  ],
  "partyStateDecisionRule": "上から最初にmatchする一件を採用する。最後のdefault unknownが全未列挙組合せをfail closedする。",
