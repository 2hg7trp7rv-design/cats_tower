      "expectedCodes": [
        "RUN_PLAN_NAMESPACES",
        "RUN_PLAN_NAMESPACE_OVERLAP",
        "RUN_PLAN_SEED_COLLISION"
      ]
    },
    {
      "id": "v1-reuse",
      "mutation": {
