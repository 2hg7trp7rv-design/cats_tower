{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cats-tower.invalid/schema/gameplay-result-v2.schema.json",
  "title": "Cat's Tower Step 3 gameplay partition result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "deterministicPayload", "hashes", "evidence", "verdict"],
  "properties": {
    "schemaVersion": {"const": "2.1.0"},
    "resultId": {"type": "string", "pattern": "^cats-tower-(step2-contract-smoke|step3)-(calibration|holdout)-[0-9]{3}$"},
    "deterministicPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "partition", "tuningVisible", "candidateId", "scenarioAlgorithmVersion", "executionVersion", "roundingVersion", "seedNamespace", "seedsPerCell", "expectedScenarioCount", "scenarioCount", "complete", "cells", "summary", "violations"],
      "properties": {
        "mode": {"enum": ["STEP2_STEP3_CONTRACT_SMOKE", "STEP3_GAMEPLAY_PARTITION"]},
        "partition": {"enum": ["calibration", "holdout"]},
        "tuningVisible": {"type": "boolean"},
        "candidateId": {"const": "cats-tower-v2-candidate-001"},
        "scenarioAlgorithmVersion": {"const": "cats-tower-scenario-v2.1.0"},
        "executionVersion": {"const": "cats-tower-step3-executor-v1.0.0"},
        "roundingVersion": {"const": "ct-rational-half-even-v1"},
        "seedNamespace": {"type": "string", "pattern": "^cats-tower-v2-(calibration|holdout-unseen)$"},
        "seedsPerCell": {"$ref": "#/$defs/positive"},
        "expectedScenarioCount": {"$ref": "#/$defs/positive"},
        "scenarioCount": {"$ref": "#/$defs/positive"},
        "complete": {"type": "boolean"},
        "cells": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/cell"}},
        "summary": {"$ref": "#/$defs/globalSummary"},
        "violations": {"type": "array", "items": {"type": "object"}}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateSha256", "runPlanSha256", "executionContractSha256", "deterministicPayloadSha256"],
      "properties": {
        "candidateSha256": {"$ref": "#/$defs/digest"},
        "runPlanSha256": {"$ref": "#/$defs/digest"},
        "executionContractSha256": {"$ref": "#/$defs/digest"},
        "deterministicPayloadSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeVersion", "executedAt", "reproductionCommand", "canonicalJsonSha256"],
      "properties": {
        "runtimeVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+"},
        "executedAt": {"type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
        "reproductionCommand": {"type": "string"},
        "canonicalJsonSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractValidation", "balanceQualification", "partitionComplete", "step3PromotionAllowed", "partialResultPromotion"],
      "properties": {
        "contractValidation": {"const": "PASS"},
        "balanceQualification": {"enum": ["NOT_EVALUATED_CONTRACT_SMOKE", "PENDING_STEP3_FINAL_JUDGE"]},
        "partitionComplete": {"type": "boolean"},
        "step3PromotionAllowed": {"const": false},
        "partialResultPromotion": {"const": false}
      }
    }
  },
  "$defs": {
    "positive": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimum", "maximum", "p50", "p90", "p99"],
      "properties": {
        "count": {"$ref": "#/$defs/positive"},
        "minimum": {"$ref": "#/$defs/positive"},
        "maximum": {"$ref": "#/$defs/positive"},
        "p50": {"$ref": "#/$defs/positive"},
        "p90": {"$ref": "#/$defs/positive"},
        "p99": {"$ref": "#/$defs/positive"}
      }
    },
    "horizonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizonId", "estimatedReachMinutes"],
      "properties": {
        "horizonId": {"enum": ["1-10F", "100F", "1000F", "10000F-or-equivalent", "repeated-resets", "30-45-day-economy"]},
        "estimatedReachMinutes": {"$ref": "#/$defs/summary"}
      }
    },
    "cellMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstResetMinutes", "featuredGuaranteeDay", "horizons"],
      "properties": {
        "firstResetMinutes": {"$ref": "#/$defs/summary"},
        "featuredGuaranteeDay": {"$ref": "#/$defs/summary"},
        "horizons": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/horizonSummary"}}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "buildId", "personaId", "seedCount", "scenarioDigests", "metrics"],
      "properties": {
        "cellId": {"type": "string"},
        "buildId": {"enum": ["build.combat", "build.reinforcement", "build.commerce"]},
        "personaId": {"enum": ["no-ad-f2p", "rewarded-ad-f2p", "monthly-pass", "controlled-payer", "high-spend-stress"]},
        "seedCount": {"$ref": "#/$defs/positive"},
        "scenarioDigests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "metrics": {"$ref": "#/$defs/cellMetrics"}
      }
    },
    "globalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildCount", "personaCount", "cellCount", "firstResetMinutes", "featuredGuaranteeDay"],
      "properties": {
        "buildCount": {"const": "3"},
        "personaCount": {"const": "5"},
        "cellCount": {"const": "15"},
        "firstResetMinutes": {"$ref": "#/$defs/summary"},
        "featuredGuaranteeDay": {"$ref": "#/$defs/summary"}
      }
    }
  }
}
